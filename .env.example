# ============================================
# CasaLead — variáveis de ambiente
# Copie para .env e preencha os valores.
# ============================================

# --- Groq API (LLM em nuvem) ---
# Chave gratuita em https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_SMART=openai/gpt-oss-120b

# --- Aplicação ---
# DEMO_MODE=true força o motor determinístico,
# permitindo demonstrar o sistema sem chave de API.
DEMO_MODE=false
DATABASE_PATH=data/runtime/casalead.db
LOG_LEVEL=INFO
